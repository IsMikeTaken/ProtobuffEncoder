<Project>

	<!--
	  Directory.Build.targets — post-import customisation for all projects.

	  Properties here run AFTER each project's own props, so they can react
	  to values set by individual .csproj files (e.g. IsPackable, OutputType).

	  Rules enforced here:
	    • Test projects are never packable and never ship XML docs to NuGet.
	    • TreatWarningsAsErrors is relaxed for test projects so CS1591 noise
	      from generated xUnit infrastructure does not break the build.
	    • Analyzer projects (netstandard2.0) keep their own settings untouched.
	-->

	<!-- ── Test-project overrides ──────────────────────────────────────── -->
	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<IsPackable>false</IsPackable>
		<!-- Tests generate no NuGet package docs — reduce noise -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- Tests can use nullable without treating doc-comment warnings as errors -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsAsErrors>CS8600;CS8602;CS8603;CS8618;CS8625</WarningsAsErrors>
	</PropertyGroup>

	<!-- ── Tool / executable overrides ────────────────────────────────── -->
	<PropertyGroup Condition="'$(OutputType)' == 'Exe' AND !$(MSBuildProjectName.EndsWith('.Tests'))">
		<!-- Executables are not library packages -->
		<!-- (Tool projects set PackAsTool themselves; just ensure IsPackable
		     is not accidentally cleared by the shared defaults above.)    -->
	</PropertyGroup>

	<!-- ── Deterministic source paths for reproducible builds ─────────── -->
	<!-- Strips the machine-specific path prefix from PDB source links so  -->
	<!-- binaries are byte-for-byte reproducible across CI agents.         -->
	<PropertyGroup Condition="'$(Deterministic)' == 'true'">
		<PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
	</PropertyGroup>

</Project>
